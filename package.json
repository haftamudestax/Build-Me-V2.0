{
  "name": "build-me-version2",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",

    "test": "pnpm test:workspace && pnpm api:test && pnpm analytics:test",
    "test:workspace": "turbo run test",

    "api:test": "pnpm --filter @build-me/api-tests test",
    "api:test:unit": "pnpm --filter @build-me/api-tests test:unit",
    "api:test:integration": "pnpm --filter @build-me/api-tests test:integration",

    "analytics:test": "uv run --directory services/analytics pytest ../../tests/analytics/ -v",

    "db:generate": "pnpm --filter @build-me/database db:generate",
    "db:migrate": "pnpm --filter @build-me/database db:migrate"
  },
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "handlebars": "^4.7.10",
      "flatted": ">=3.4.2",
      "lodash": ">=4.18.0",
      "underscore": ">=1.13.8",
      "brace-expansion": "^5.0.11",
      "nanoid": "3.3.18",
      "@faker-js/faker": "10.6.0",
      "express>proxy-addr": "^2.0.8",
      "postman-runtime>handlebars": "^4.7.10",
      "axios": "^1.20.0",
      "joi": "^18.2.6",
      "source-map-js": "^1.2.2",
      "follow-redirects": "^1.16.1",
      "vite": "^8.3.4",
      "eslint-plugin-react-hooks>zod": "4.6.6",
      "body-parser@^1.20.8": "1.20.9",
      "body-parser@^2.3.0": "2.4.0"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "start-server-and-test": "^3.0.11",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typescript": "5.9.3"
  }
}
