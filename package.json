{
  "name": "build-me-version2",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @build-me/database db:generate",
    "db:migrate": "pnpm --filter @build-me/database db:migrate"
  },
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "handlebars": ">=4.7.9",
      "node-forge": ">=1.4.0",
      "flatted": ">=3.4.2",
      "lodash": ">=4.18.0",
      "underscore": ">=1.13.8",
      "brace-expansion": ">=5.0.9",
      "nanoid": "3.3.18",
      "@faker-js/faker": "10.6.0"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "start-server-and-test": "^3.0.11",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typescript": "5.9.3"
  }
}
